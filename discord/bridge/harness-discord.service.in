[Unit]
Description=Harness Discord bridge (talk to Harness Maxxing sessions from Discord)
After=network-online.target claude-maxxing.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStart="@VENV@/bin/python" -m harness_discord
Restart=always
RestartSec=5
# Keys (DISCORD_BOT_TOKEN, HARNESS_PASSWORD) are read from the Harness Keys vault with `maxxing keys get`.
# PATH must contain `maxxing` (check: command -v maxxing; the installer refuses to go on otherwise).
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Hardening: the bridge only needs the network and its state folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The only folder the bridge writes (config, state, status). The virtualenv is read-only at run time.
# install.sh creates it first: a missing path would stop the unit from starting.
ReadWritePaths=@STATE@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
MemoryMax=512M

[Install]
WantedBy=multi-user.target
