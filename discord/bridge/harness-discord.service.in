[Unit]
Description=Harness Discord bridge (talk to Harness Maxxing sessions from Discord)
After=network-online.target claude-maxxing.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DIR@
ExecStart="@VENV@/bin/python" -m harness_discord
Restart=always
RestartSec=5
# Keys (DISCORD_BOT_TOKEN, HARNESS_PASSWORD) are read from the Harness Keys vault with `maxxing keys get`.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Hardening: the bridge only needs the network and its state folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/claude-maxxing
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
